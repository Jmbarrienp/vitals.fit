# Vitals Fit -- reglas de ignore a nivel raiz (UTF-8)

# dependencias
node_modules/
**/node_modules/

# build / artefactos compilados (NO se trackean -- se generan en build)
dist/
**/dist/
build/
**/build/
.expo/
web-build/
*.tsbuildinfo

# entornos / secretos (NUNCA commitear) -- se permite .env.example
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# llaves y credenciales
*.pem
*.key
*.p12
*.jks
*.p8
*.mobileprovision

# logs (archivos .log en cualquier nivel; NO ignorar dirs de código como src/logs)
*.log
**/*.log

# basura de SO / editor
.DS_Store
Thumbs.db

# carpeta huerfana
fitness-app/
