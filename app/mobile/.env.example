# Mobile (Expo) — variables públicas. NO poner secretos aquí.
# Solo claves EXPO_PUBLIC_* (se embeben en el bundle del cliente).
EXPO_PUBLIC_API_URL=https://vitals-fit.onrender.com/api

# Nutrition Vision V1 — pon 'true' para mostrar el botón de escaneo con cámara.
# Por defecto (ausente/false) el flujo manual es el único visible.
EXPO_PUBLIC_VISION_ENABLED=false

# Nutrition Vision V3.1 — pon 'true' para mostrar el botón de escaneo de
# código de barras. Flag INDEPENDIENTE de EXPO_PUBLIC_VISION_ENABLED (cada
# modalidad se activa por separado). Por defecto (ausente/false) oculto.
EXPO_PUBLIC_BARCODE_ENABLED=false
