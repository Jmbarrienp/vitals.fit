{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npx prisma generate && node ./node_modules/@nestjs/cli/bin/nest.js build",
    "start": "node dist/main",
    "dev": "npx tsc && node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "migrate:deploy": "npx prisma migrate deploy",
    "migrate:status": "npx prisma migrate status",
    "smoke:1c": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-1c.ts",
    "smoke:state": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-state.ts",
    "smoke:rec": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-rec.ts",
    "smoke:ledger": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-ledger.ts",
    "smoke:review": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-review.ts",
    "smoke:contract": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-contract.ts",
    "smoke:coach": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-coach.ts",
    "smoke:planner": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-planner.ts",
    "smoke:mealplan": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-mealplan.ts",
    "smoke:vision": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-vision.ts",
    "smoke:learning": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-learning.ts",
    "smoke:rollout": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-rollout.ts",
    "smoke:governance": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-governance.ts",
    "smoke:promotion": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-promotion.ts",
    "smoke:rollback": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-rollback.ts",
    "smoke:canary": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-canary.ts",
    "smoke:copilot": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-copilot.ts",
    "smoke:dailycopilot": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-dailycopilot.ts",
    "smoke:production": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-production.ts",
    "eval:vision": "ts-node -P tsconfig.smoke.json --transpile-only scripts/eval-vision.ts",
    "preflight": "ts-node -P tsconfig.smoke.json --transpile-only scripts/preflight.ts",
    "smoke:deploy": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-deploy.ts",
    "deploy:check": "npm run preflight && npm run smoke:deploy",
    "lint": "eslint src scripts --max-warnings 25",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "ts-node -P tsconfig.smoke.json --transpile-only scripts/check-boundaries.ts",
    "smoke:engineering": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-engineering.ts",
    "smoke:http-contract": "ts-node -P tsconfig.smoke.json --transpile-only scripts/smoke-http-contract.ts",
    "verify:smokes": "npm run smoke:engineering && npm run smoke:http-contract && npm run smoke:1c && npm run smoke:state && npm run smoke:rec && npm run smoke:ledger && npm run smoke:review && npm run smoke:contract && npm run smoke:coach && npm run smoke:planner && npm run smoke:mealplan && npm run smoke:vision && npm run smoke:learning && npm run smoke:rollout && npm run smoke:governance && npm run smoke:promotion && npm run smoke:rollback && npm run smoke:canary && npm run smoke:copilot && npm run smoke:dailycopilot && npm run smoke:production && npm run smoke:deploy",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run check:boundaries && npm run build && npm run verify:smokes"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.1.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.6.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
