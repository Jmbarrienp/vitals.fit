# Backend (NestJS) — copiar a .env y completar con valores reales.
# .env real NUNCA se commitea (está en .gitignore).

# Postgres (Supabase) — pooler de transacción, runtime de la app (puerto 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Postgres (Supabase) — pooler de sesión, usado por Prisma Migrate (puerto 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Secreto para firmar JWT — OBLIGATORIO, mínimo 32 caracteres.
# El arranque FALLA si falta, si es demasiado corto en producción, o si usas un
# placeholder conocido ('changeme', 'secret', 'password', 'test'): ese valor es
# público en este archivo, así que cualquiera podría forjar tokens (V5.2).
# Genera uno real:  openssl rand -base64 48
JWT_SECRET=

# Puerto local (opcional)
PORT=3000

# Opcional: activa Claude en recomendaciones (si está ausente, usa rules engine)
# La MISMA key activa el reconocimiento real de Nutrition Vision (ver abajo).
# ANTHROPIC_API_KEY=

# ── Nutrition Vision ──
# Proveedor de reconocimiento activo. Default 'fixture' (determinista, coste cero,
# sin red) — con eso Vision se despliega inerte. 'claude' activa el proveedor real,
# que además necesita ANTHROPIC_API_KEY; sin ella degrada al flujo manual.
# VISION_PROVIDER=fixture

# Modelo del proveedor real. Default claude-opus-4-8.
# Niveles más baratos: claude-sonnet-5, claude-haiku-4-5. Sólo config, sin tocar código.
# VISION_MODEL=claude-opus-4-8

# ── Nutrition Vision — Label OCR (V3.2) ──
# Proveedor de transcripción de etiquetas nutricionales. Default 'fixture'
# (determinista, coste cero, sin red) — como Vision y a diferencia de Barcode,
# una llamada real cuesta dinero, así que OCR se despliega inerte. 'claude'
# activa el proveedor real, que además necesita ANTHROPIC_API_KEY; sin ella
# degrada al flujo manual.
# OCR_PROVIDER=fixture

# Modelo del proveedor real de OCR. Default claude-opus-4-8. Independiente de
# VISION_MODEL: transcribir una etiqueta y reconocer un plato son trabajos
# distintos y pueden justificar niveles distintos.
# OCR_MODEL=claude-opus-4-8

# ── Nutrition Vision — Barcode (V3.1) ──
# Proveedor de lookup de códigos de barras. Default 'openfoodfacts' (gratis,
# sin key, API pública) — a diferencia de Vision, no hay motivo para proteger
# producción detrás de un default inerte. 'fixture' fuerza datos deterministas
# (dev/CI/demo sin red).
# BARCODE_LOOKUP_PROVIDER=openfoodfacts

# ── Nutrition Vision — Provider Governance / Shadow (V4.1) ──
# Proveedor CHALLENGER a evaluar en sombra contra tráfico real. Vacío = apagado
# (default). El challenger NUNCA llega al usuario: su resultado no participa en
# la propuesta, no vota, y no entra al write path. Solo produce evidencia
# append-only para comparar ambos proveedores sobre LA MISMA foto.
# Debe estar registrado en el VisionProviderRegistry y no ser el activo.
# SHADOW_CHALLENGER_PROVIDER=

# Fracción de scans muestreados para sombra (0..1). Default 0 = apagado.
# El muestreo es DETERMINISTA por scanId (no aleatorio): el mismo scan siempre
# toma la misma decisión, así un operador puede razonar sobre qué scans tienen
# evidencia. Empieza bajo (0.1) — cada scan muestreado es una llamada de más al
# vendor, con su coste y su latencia (fuera del camino del usuario).
# SHADOW_SAMPLE_RATE=0

# ── Nutrition Vision — Auto-Accept (V3.6) ──
# Interruptor maestro de la graduación de auto-aceptación. Default 'false':
# el motor de confianza IGUAL computa, persiste y reporta cada decisión (modo
# sombra), pero nunca registra una comida sin preguntar. Así la política se
# valida contra tráfico real antes de que actúe. Ponlo en 'true' sólo después
# de revisar GET /vision/learning/trust/statistics (campo shadowOnly).
# Con 'false' la experiencia es EXACTAMENTE la de V3.5.
# AUTO_ACCEPT_ENABLED=false

# ── Nutrition Vision — Restaurant (V3.4) ──
# Fuente de menús de restaurante. Default 'none' (siempre not-found): hoy no
# existe una API de menús gratuita y sin key, y el contexto de restaurante
# funciona igualmente sin ella (solo faltan los candidatos de menú). 'fixture'
# devuelve menús deterministas (dev/CI/demo sin red).
# RESTAURANT_MENU_PROVIDER=none
