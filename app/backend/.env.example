# Backend (NestJS) — copiar a .env y completar con valores reales.
# .env real NUNCA se commitea (está en .gitignore).

# Postgres (Supabase) — pooler de transacción, runtime de la app (puerto 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Postgres (Supabase) — pooler de sesión, usado por Prisma Migrate (puerto 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Secreto para firmar JWT
JWT_SECRET=changeme

# Puerto local (opcional)
PORT=3000

# Opcional: activa Claude en recomendaciones (si está ausente, usa rules engine)
# ANTHROPIC_API_KEY=
